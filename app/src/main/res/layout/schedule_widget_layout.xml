<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/schedule_widget_header"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/schedule_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日课程"
                android:textColor="#F4F6FF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/schedule_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7月1日 星期三"
                android:textColor="#AAB6CE"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_accent_background"
            android:gravity="center"
            android:text="课"
            android:textColor="#0B1220"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/schedule_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="今天没有课程，留点时间给自己"
        android:textColor="#AAB6CE"
        android:textSize="13sp" />

    <LinearLayout android:id="@+id/schedule_widget_course_1" style="@style/WidgetCourseRow">
        <TextView android:id="@+id/schedule_widget_course_time_1" style="@style/WidgetCourseTime" />
        <TextView android:id="@+id/schedule_widget_course_title_1" style="@style/WidgetCourseTitle" />
        <TextView android:id="@+id/schedule_widget_course_room_1" style="@style/WidgetCourseRoom" />
    </LinearLayout>
    <LinearLayout android:id="@+id/schedule_widget_course_2" style="@style/WidgetCourseRow">
        <TextView android:id="@+id/schedule_widget_course_time_2" style="@style/WidgetCourseTime" />
        <TextView android:id="@+id/schedule_widget_course_title_2" style="@style/WidgetCourseTitle" />
        <TextView android:id="@+id/schedule_widget_course_room_2" style="@style/WidgetCourseRoom" />
    </LinearLayout>
    <LinearLayout android:id="@+id/schedule_widget_course_3" style="@style/WidgetCourseRow">
        <TextView android:id="@+id/schedule_widget_course_time_3" style="@style/WidgetCourseTime" />
        <TextView android:id="@+id/schedule_widget_course_title_3" style="@style/WidgetCourseTitle" />
        <TextView android:id="@+id/schedule_widget_course_room_3" style="@style/WidgetCourseRoom" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_widget_exam"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_exam_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="考试"
            android:textColor="#FDBA74"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/schedule_widget_exam_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F4F6FF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/schedule_widget_exam_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#AAB6CE"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
