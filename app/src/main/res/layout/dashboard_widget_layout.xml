<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6F4EA"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/dashboard_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JNU Smart Edu"
        android:textColor="#137333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dashboard_widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Open app for schedule"
        android:textColor="#1E4620"
        android:textSize="13sp" />
</LinearLayout>
