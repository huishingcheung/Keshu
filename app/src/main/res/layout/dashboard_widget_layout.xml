<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/task_widget_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_accent_background"
            android:contentDescription="@string/widget_tasks_title"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/task_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/widget_tasks_title"
            android:textColor="#10213F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/task_widget_count"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_count_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/widget_count_zero"
            android:textColor="#155EEF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/task_widget_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="@string/widget_add_task"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_add" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_add_first_task"
            android:textColor="#5A667A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_1"
        style="@style/WidgetTaskRow"
        android:visibility="gone">
        <TextView android:id="@+id/task_widget_check_1" style="@style/WidgetTaskCheck" />
        <LinearLayout style="@style/WidgetTaskTextColumn">
            <TextView android:id="@+id/task_widget_item_title_1" style="@style/WidgetTaskTitle" />
            <TextView android:id="@+id/task_widget_item_date_1" style="@style/WidgetTaskMeta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_2"
        style="@style/WidgetTaskRow"
        android:visibility="gone">
        <TextView android:id="@+id/task_widget_check_2" style="@style/WidgetTaskCheck" />
        <LinearLayout style="@style/WidgetTaskTextColumn">
            <TextView android:id="@+id/task_widget_item_title_2" style="@style/WidgetTaskTitle" />
            <TextView android:id="@+id/task_widget_item_date_2" style="@style/WidgetTaskMeta" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/task_widget_row_3"
        style="@style/WidgetTaskRow"
        android:visibility="gone">
        <TextView android:id="@+id/task_widget_check_3" style="@style/WidgetTaskCheck" />
        <LinearLayout style="@style/WidgetTaskTextColumn">
            <TextView android:id="@+id/task_widget_item_title_3" style="@style/WidgetTaskTitle" />
            <TextView android:id="@+id/task_widget_item_date_3" style="@style/WidgetTaskMeta" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
